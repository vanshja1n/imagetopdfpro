{
  "id": "/",
  "name": "ImageToPDF Pro",
  "short_name": "ImageToPDF Pro",
  "description": "ImageToPDF Pro is a free online image-to-PDF converter that combines multiple JPG, PNG, JPEG, and WEBP images into one PDF file. Everything is processed locally in your browser, so your images never need to be uploaded.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#F4F0EA",
  "theme_color": "#FF5C00",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "images",
          "accept": [
            "image/*",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ],
        "image/bmp": [
          ".bmp"
        ],
        "image/avif": [
          ".avif"
        ],
        "image/heic": [
          ".heic"
        ],
        "image/heif": [
          ".heif"
        ]
      }
    }
  ]
}